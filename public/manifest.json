{
  "manifest_version": 3,
  "name": "Smart URL Copy",
  "version": "0.1.0",
  "description": "Copy the page title and URL in your own format, such as a Markdown link. Rules can edit them first.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Smart URL Copy",
    "default_icon": {
      "16": "icons/default-16.png",
      "24": "icons/default-24.png",
      "32": "icons/default-32.png",
      "128": "icons/default-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/default-16.png",
    "48": "icons/default-48.png",
    "128": "icons/default-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
