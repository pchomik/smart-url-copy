{
  "manifest_version": 3,
  "name": "Advance Copy",
  "version": "0.1.0",
  "description": "Copy the current page title and URL as a rendered template to the clipboard.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Advance Copy",
    "default_icon": {
      "16": "icons/default-16.png",
      "48": "icons/default-48.png",
      "128": "icons/default-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/default-16.png",
    "48": "icons/default-48.png",
    "128": "icons/default-128.png"
  },
  "permissions": []
}
